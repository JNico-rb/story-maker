{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.82",
        "--browser",
        "msedge",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "langfuse": {
      "type": "http",
      "url": "https://cloud.langfuse.com/api/public/mcp",
      "headers": {
        "Authorization": "${LANGFUSE_MCP_AUTH}"
      }
    }
  }
}
