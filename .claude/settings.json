{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/novelas/**)",
      "Edit(/optimizaciones/**)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add novelas/*)",
      "Bash(git add -A novelas/*)",
      "Bash(git commit -m *)",
      "Bash(git reset -q HEAD -- novelas/*)",
      "Bash(git checkout -- novelas/*)",
      "Bash(git clean -fdq novelas/*)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(date*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.claude/settings.local.json)",
      "Read(herramientas/optimizacion/conjuntos/**)",
      "Bash(git push*)",
      "Bash(git commit --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/inmutables.sh\"",
            "statusMessage": "Comprobando inmutabilidad de artefactos aprobados"
          }
        ]
      }
    ]
  }
}
