{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/dev/guard.mjs\""
          }
        ]
      }
    ]
  }
}
