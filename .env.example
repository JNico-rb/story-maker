# Ajustes del servidor (docs/architecture.md §15.5). Solo marcadores: copia este fichero a .env y rellénalo.

# Directorio de datos: la base SQLite y pdf/
STORY_MAKER_DATA_DIR=
# Ruta de config.json
STORY_MAKER_CONFIG=

# Verificador formal de la cronología: local (lake build) o github (GitHub Actions)
FORMAL_VERIFIER=github

# Lean en GitHub Actions: repositorio, workflow y token (solo con FORMAL_VERIFIER=github)
GITHUB_REPOSITORY=owner/repo
LEAN_WORKFLOW=lean-verify.yml
# Token de grano fino, limitado al repositorio: Actions de lectura y escritura, Metadata de lectura
GITHUB_TOKEN=

# Langfuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# Etiqueta con la que se leen los prompts de Langfuse
LANGFUSE_PROMPT_LABEL=production

# Secreto con el que se firman los JWT: 32 caracteres o más. Solo con el login opcional
JWT_SECRET=

# Lo que imprime Playwright y a lo que habla la CLI
STORY_MAKER_BASE_URL=http://127.0.0.1:8000
# El build del frontend que sirve FastAPI; por defecto, frontend/dist
STORY_MAKER_FRONTEND_DIST=

# Token OAuth de la cuenta de Claude, para CI u otra máquina; sin él, el CLI usa el login de la
# máquina. No lo lee settings: lo hereda el Agent SDK.
# CLAUDE_CODE_OAUTH_TOKEN=
