# Ajustes del servidor (docs/architecture.md §15.5). Solo marcadores: copia este fichero a .env y rellénalo.

# Directorio de datos: la base SQLite, PDF y ficheros Lean. Por defecto, backend/data
STORY_MAKER_DATA_DIR=
# Ruta de config.json. Por defecto, config.json en la raíz del repositorio
STORY_MAKER_CONFIG=
# URL base del servidor, con la que Playwright abre la VistaDeVersion. Por defecto, http://127.0.0.1:8000
STORY_MAKER_BASE_URL=
# Build de la SPA que sirve FastAPI. Por defecto, frontend/dist
STORY_MAKER_FRONTEND_DIST=

# Secreto con el que se firman los JWT: 32 caracteres o más. Obligatorio
JWT_SECRET=

# Proveedor de los roles: claude_login (por defecto) o anthropic_compatible
LLM_PROVIDER=
# Solo con claude_login en una máquina sin sesión del CLI: el token de `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Solo con LLM_PROVIDER=anthropic_compatible: endpoint y clave de la API de Anthropic, OpenRouter,
# Ollama o un proxy
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Solo con LLM_PROVIDER=anthropic_compatible vía OpenRouter, como alternativa a las dos anteriores
OPENROUTER_API_KEY=

# Modo del VerificadorFormal: local o github. Obligatorio
FORMAL_VERIFIER=
# Lean en GitHub Actions: repositorio (usuario/repo), workflow y token (solo con FORMAL_VERIFIER=github)
# El workflow es verificar-cronologia.yml. Token fine-grained sobre ese repo con el permiso Actions: Read and write
GITHUB_REPOSITORY=
LEAN_WORKFLOW=verificar-cronologia.yml
GITHUB_TOKEN=

# Langfuse Cloud UE, plan Hobby
LANGFUSE_PROMPT_LABEL=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# LANGFUSE_MCP_AUTH es de Claude Code en el desarrollo, no del producto: va en el entorno del
# usuario y el backend no la lee. No se declara aquí.
