# Ajustes del servidor (docs/definitions.md §11). Solo marcadores: copia este fichero a .env y rellénalo.

# Directorio de datos: el único en el que escribe el backend
STORY_MAKER_DATA_DIR=
# Ruta de config.json
STORY_MAKER_CONFIG=

# Validador formal de la historia: local (lake build) o github (GitHub Actions)
FORMAL_VERIFIER=github

# Secreto con el que se firman los JWT: 32 caracteres o más
JWT_SECRET=

# Lean en GitHub Actions: repositorio, workflow y token
GITHUB_REPOSITORY=owner/repo
LEAN_WORKFLOW=lean-verify.yml
# Token de grano fino, limitado al repositorio: Actions de lectura y escritura, Metadata de lectura
GITHUB_TOKEN=

# Etiqueta con la que se leen los prompts de Langfuse
LANGFUSE_PROMPT_LABEL=production

# Credenciales locales de observabilidad (Langfuse)
LANGFUSE_SECRET_KEY="sk-"
LANGFUSE_PUBLIC_KEY="pk-"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# OpenRouter API Key
# El backend la traduce al entorno del Agent SDK: ANTHROPIC_BASE_URL=https://openrouter.ai/api,
# ANTHROPIC_AUTH_TOKEN=<esta clave> y ANTHROPIC_API_KEY="", vacía a propósito.
OPENROUTER_API_KEY="sk-"
